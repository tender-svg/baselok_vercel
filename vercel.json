{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://cmsapi.qpaix.com/baselok/api/:path*" },
    { "source": "/admin/:path*", "destination": "https://cmsapi.qpaix.com/baselok/admin/:path*" },
    { "source": "/case-study-:slug.html", "destination": "/case-study-details.html" },
    { "source": "/blog-:slug.html", "destination": "/blog-details.html" },
    { "source": "/webinar-:slug.html", "destination": "/blog-details.html" },
    { "source": "/solution-:slug.html", "destination": "/solution-referencefile.html" }
  ]
}
